# Windows GNU toolchain: always link with rustup's own msvcrt-flavoured mingw.
#
# If another mingw is first on PATH (e.g. WinLibs *UCRT*), proc-macro DLLs get linked
# against the UCRT and fail to initialise inside rustc (LoadLibrary error 1114), which
# surfaces as "error[E0463]: can't find crate for `tauri_macros`".
# dlltool is a local shim (~/.cargo/bin/dlltool_shim.rs) that builds raw-dylib import libs with rust-lld;
# binutils dlltool yields binaries that crash in std startup. Adjust user paths if they differ.
[target.x86_64-pc-windows-gnu]
linker = "C:/Users/nbz14/.rustup/toolchains/stable-x86_64-pc-windows-gnu/lib/rustlib/x86_64-pc-windows-gnu/bin/self-contained/x86_64-w64-mingw32-gcc.exe"
rustflags = ["-C", "dlltool=C:/Users/nbz14/.cargo/bin/dlltool.exe"]
