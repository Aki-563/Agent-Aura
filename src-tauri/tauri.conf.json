{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Aura",
  "version": "0.1.0",
  "identifier": "com.agentaura.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "npm --prefix ui run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Agent Aura",
        "url": "index.html",
        "width": 1040,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": true,
        "transparent": true,
        "focus": true,
        "minWidth": 640,
        "minHeight": 480,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Agent Aura",
    "shortDescription": "Windows desktop agent",
    "windows": {
      "signCommand": "..\\tools\\sign.cmd %1",
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "mainBinaryName": "agent-aura"
}